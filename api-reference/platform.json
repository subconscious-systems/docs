{
  "openapi": "3.1.0",
  "info": {
    "title": "Subconscious platform API",
    "version": "1.0.0",
    "description": "Inference-key management, priced model discovery, and organization usage on the Subconscious platform. Inference stays on https://api.subconscious.dev/v1."
  },
  "servers": [
    {
      "url": "https://platform.subconscious.dev"
    }
  ],
  "paths": {
    "/api/v1/management/api-keys": {
      "post": {
        "operationId": "createInferenceKey",
        "summary": "Create an inference key",
        "description": "Mints an inference key for the organization that owns the management key. The `key` secret is returned once. Later delete calls use `keyPrefix`. A management key cannot run inference. Inference keys presented here are rejected.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl https://platform.subconscious.dev/api/v1/management/api-keys \\\n  -H \"Authorization: Bearer sk-mgmt-...\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"name\": \"tenant-42\"}'"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "description": "Display name for the inference key. Must be non-empty after trimming and at most 255 characters.",
                    "example": "tenant-42"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inference key created. `key` is shown only in this response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiKey"
                  ],
                  "properties": {
                    "apiKey": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "key",
                        "keyPrefix",
                        "createdAt"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Platform id of the key."
                        },
                        "name": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string",
                          "description": "Inference secret (`sk-gw-...`). Store it now. It is not returned again."
                        },
                        "keyPrefix": {
                          "type": "string",
                          "description": "Prefix used by the delete endpoint."
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "apiKey": {
                    "id": "5f0c8a1e-2b4d-4c7e-9a10-6d3f2e1b0c9a",
                    "name": "tenant-42",
                    "key": "sk-gw-...",
                    "keyPrefix": "a1b2c3d4",
                    "createdAt": "2026-09-30T21:40:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON, `name` is missing or longer than 255 characters, or the organization is at its inference-key limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "name": {
                    "value": {
                      "error": "Body must include a non-empty \"name\" (max 255 chars)"
                    }
                  },
                  "limit": {
                    "value": {
                      "error": "Maximum number of keys is 10"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or inactive management key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The key is not a management key, or the organization does not have closed-beta access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notManagement": {
                    "value": {
                      "error": "Key is not a management API key"
                    }
                  },
                  "closedBeta": {
                    "value": {
                      "error": "Closed-beta access is required"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The key could not be created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listInferenceKeys",
        "summary": "List inference keys",
        "description": "Lists inference keys for the organization that owns the management key, newest first. Includes inactive keys. Hidden keys and management keys are omitted. Secrets are not included.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl https://platform.subconscious.dev/api/v1/management/api-keys \\\n  -H \"Authorization: Bearer sk-mgmt-...\""
          }
        ],
        "responses": {
          "200": {
            "description": "Inference keys for the organization.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiKeys"
                  ],
                  "properties": {
                    "apiKeys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "keyPrefix",
                          "isActive",
                          "createdAt",
                          "lastUsedAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "keyPrefix": {
                            "type": "string"
                          },
                          "isActive": {
                            "type": "boolean",
                            "description": "False after the key has been deleted."
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "lastUsedAt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "apiKeys": [
                    {
                      "id": "5f0c8a1e-2b4d-4c7e-9a10-6d3f2e1b0c9a",
                      "name": "tenant-42",
                      "keyPrefix": "a1b2c3d4",
                      "isActive": true,
                      "createdAt": "2026-09-30T21:40:00.000Z",
                      "lastUsedAt": "2026-09-30T22:05:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or inactive management key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The key is not a management key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/management/api-keys/{keyPrefix}": {
      "delete": {
        "operationId": "deleteInferenceKey",
        "summary": "Delete an inference key",
        "description": "Revokes the inference key at the gateway and deactivates it. Requests that still present the deleted key fail. The lookup is limited to active inference keys in the management key's organization. Management keys cannot be deleted here.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl -X DELETE https://platform.subconscious.dev/api/v1/management/api-keys/a1b2c3d4 \\\n  -H \"Authorization: Bearer sk-mgmt-...\""
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/keyPrefix"
          }
        ],
        "responses": {
          "200": {
            "description": "The key was revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revoked",
                    "id",
                    "keyPrefix"
                  ],
                  "properties": {
                    "revoked": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "id": {
                      "type": "string"
                    },
                    "keyPrefix": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "revoked": true,
                  "id": "5f0c8a1e-2b4d-4c7e-9a10-6d3f2e1b0c9a",
                  "keyPrefix": "a1b2c3d4"
                }
              }
            }
          },
          "401": {
            "description": "Missing or inactive management key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The key is not a management key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No active inference key in this organization matches the prefix.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "No active API key with prefix a1b2c3d4"
                }
              }
            }
          },
          "502": {
            "description": "The gateway did not revoke the key. The platform key stays active. Retry the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The key could not be deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "operationId": "listModelsWithPricing",
        "summary": "List models with pricing",
        "description": "Returns the caller's model catalog with per-token prices. The platform reads the gateway catalog for the same key and adds the prices the key pays. A model is listed only when the key can invoke it, the platform has a display row for it, and it carries a price. The default format is an OpenRouter Provider V2 model list. Request `?format=models.dev` for a models.dev provider document. Prices are USD per token in the default format, and USD per million tokens in the models.dev format. Authenticate with an inference key (`Authorization: Bearer` or `X-API-Key`). Management keys are rejected.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "models.dev"
              ]
            },
            "description": "Serialization format. Omit for OpenRouter Provider V2. `models.dev` returns a models.dev provider document."
          }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl https://platform.subconscious.dev/api/v1/models \\\n  -H \"Authorization: Bearer sk-gw-...\""
          },
          {
            "lang": "bash",
            "label": "models.dev",
            "source": "curl \"https://platform.subconscious.dev/api/v1/models?format=models.dev\" \\\n  -H \"Authorization: Bearer sk-gw-...\""
          }
        ],
        "x-mint": {
          "content": "## Response schemas\n\nThe response shape follows the `format` query parameter. Download the schema for each format, or read the upstream provider documentation.\n\n<CardGroup cols={2}>\n  <Card title=\"OpenRouter Provider V2\" icon=\"download\" href=\"https://openrouter.ai/docs/assets/provider-monitor-schema-v2.openapi.json\">\n    OpenRouter provider schema, as an OpenAPI 3.1 JSON document. The default format.\n  </Card>\n  <Card title=\"OpenRouter integration guide\" icon=\"book\" href=\"https://openrouter.ai/docs/guides/providers/integration\">\n    How OpenRouter reads a provider feed and which fields it bills.\n  </Card>\n  <Card title=\"models-dev.schema.json\" icon=\"download\" href=\"/schemas/models-dev.schema.json\">\n    JSON Schema for `?format=models.dev`. Prices are USD per million tokens.\n  </Card>\n  <Card title=\"models.dev catalog\" icon=\"book\" href=\"https://models.dev/api.json\">\n    The upstream models.dev document this format follows.\n  </Card>\n</CardGroup>\n\nBoth schemas are open. Unknown fields are accepted, no field is required, and enumerated values are documented as examples. Fields are added without notice, and an absent field means we do not know the value, never that the value is unsupported.\n"
        },
        "responses": {
          "200": {
            "description": "Priced model catalog in the requested format.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OpenRouterModelList"
                    },
                    {
                      "$ref": "#/components/schemas/ModelsDevProvider"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The `format` value is not supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unsupported format \"litellm\""
                }
              }
            }
          },
          "401": {
            "description": "Missing, inactive, or non-inference API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The gateway catalog could not be read. The feed fails rather than return a partial catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Model discovery is temporarily unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Get usage",
        "description": "Today's usage for the organization that owns the inference key: billing terms, plan, credit balance, the active invoice window for invoiced organizations, and tokens consumed today by model. Prepaid organizations also get a daily allowance percentage; invoiced organizations bill against their spend limit instead. Authenticate with an inference key (`Authorization: Bearer` or `X-API-Key`). Management keys are rejected. The allowance is a percentage of today's grant. The grant amount itself is not included.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl https://platform.subconscious.dev/api/v1/usage \\\n  -H \"Authorization: Bearer sk-gw-...\""
          }
        ],
        "responses": {
          "200": {
            "description": "Organization usage snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                },
                "example": {
                  "billingTerms": "prepaid",
                  "plan": {
                    "label": "Heavy",
                    "status": "active",
                    "dailyAllowance": {
                      "basis": "credit",
                      "percent": 5.5,
                      "resetAt": "2026-09-24T00:00:00.000Z"
                    }
                  },
                  "credits": {
                    "balanceDollars": 12.34,
                    "overageThisPeriodDollars": 0
                  },
                  "invoice": null,
                  "models": [
                    {
                      "slug": "subconscious/glm-5.3-marathon",
                      "consumedToday": 44500000
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, inactive, or non-inference API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The organization does not have closed-beta access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Closed-beta access is required"
                }
              }
            }
          },
          "502": {
            "description": "Usage could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key in the Authorization header. Management endpoints require a management key (`sk-mgmt-...`). GET /api/v1/models and GET /api/v1/usage require an inference key (`sk-gw-...`)."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Same key as bearer auth, passed in the X-API-Key header."
      }
    },
    "parameters": {
      "keyPrefix": {
        "name": "keyPrefix",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "example": "a1b2c3d4"
        },
        "description": "Prefix returned when the inference key was created."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "OpenRouterModelList": {
        "type": "object",
        "title": "OpenRouter Provider V2",
        "description": "Model documents, one entry per priced model. `cost_usd` is USD per unit, which is per token when `unit` is `token`.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpenRouterModelDocument"
            }
          }
        }
      },
      "OpenRouterModelDocument": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "name",
          "created",
          "input_modalities",
          "output_modalities",
          "openrouter"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "2.4"
            ]
          },
          "id": {
            "type": "string",
            "description": "The model id to send in inference requests.",
            "example": "subconscious/glm-5.3-marathon"
          },
          "name": {
            "type": "string",
            "description": "Display name, prefixed with the provider.",
            "example": "Subconscious: GLM 5.3 Marathon"
          },
          "description": {
            "type": "string"
          },
          "created": {
            "type": "integer"
          },
          "input_modalities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "image"
                  ]
                },
                "supported_inputs": {
                  "type": "object"
                },
                "pricing": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OpenRouterPricingEntry"
                  }
                }
              }
            }
          },
          "output_modalities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "supported_parameters"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text"
                  ]
                },
                "max_length": {
                  "$ref": "#/components/schemas/TokenLimit"
                },
                "streaming": {
                  "type": "boolean"
                },
                "supported_parameters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                },
                "pricing": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OpenRouterPricingEntry"
                  }
                }
              }
            }
          },
          "openrouter": {
            "type": "object",
            "required": [
              "slug"
            ],
            "properties": {
              "slug": {
                "type": "string"
              }
            }
          }
        },
        "example": {
          "schema_version": "2.4",
          "id": "subconscious/glm-5.3-marathon",
          "name": "Subconscious: GLM 5.3 Marathon",
          "description": "Flagship reasoning model on OrangeLine.",
          "created": 1762060800,
          "input_modalities": [
            {
              "type": "text",
              "supported_inputs": {
                "max_context_length": {
                  "value": 200000,
                  "unit": "token"
                }
              },
              "pricing": [
                {
                  "type": "prompt",
                  "unit": "token",
                  "cost_usd": "0.0000014"
                },
                {
                  "type": "cached_prompt",
                  "unit": "token",
                  "cost_usd": "0.00000026"
                }
              ]
            }
          ],
          "output_modalities": [
            {
              "type": "text",
              "max_length": {
                "value": 32000,
                "unit": "token"
              },
              "streaming": true,
              "supported_parameters": {
                "temperature": {
                  "type": "range",
                  "min": 0,
                  "max": 2
                },
                "max_tokens": {
                  "type": "integer",
                  "min": 1,
                  "max": 32000,
                  "unit": "token"
                }
              },
              "pricing": [
                {
                  "type": "completion",
                  "unit": "token",
                  "cost_usd": "0.0000044"
                }
              ]
            }
          ],
          "openrouter": {
            "slug": "subconscious/glm-5.3-marathon"
          }
        }
      },
      "TokenLimit": {
        "type": "object",
        "required": [
          "value",
          "unit"
        ],
        "properties": {
          "value": {
            "type": "integer"
          },
          "unit": {
            "type": "string",
            "enum": [
              "token"
            ]
          }
        }
      },
      "OpenRouterPricingEntry": {
        "type": "object",
        "description": "One price for one thing the caller consumes. `prompt` and `cached_prompt` sit under an input modality. `completion` sits under an output modality.",
        "required": [
          "type",
          "unit",
          "cost_usd"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "prompt",
              "cached_prompt",
              "completion"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "token",
              "image",
              "megapixel",
              "second",
              "character"
            ]
          },
          "cost_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$",
            "description": "Non-negative decimal number string in USD per unit.",
            "example": "0.0000014"
          }
        }
      },
      "ModelsDevProvider": {
        "type": "object",
        "title": "models.dev",
        "description": "A provider map keyed by model id, following the models.dev catalog shape.",
        "properties": {
          "subconscious": {
            "type": "object",
            "required": [
              "id",
              "name",
              "api",
              "models"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "subconscious"
                ]
              },
              "name": {
                "type": "string"
              },
              "api": {
                "type": "string",
                "description": "Inference base URL for this provider."
              },
              "models": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/ModelsDevModel"
                }
              }
            }
          }
        }
      },
      "ModelsDevModel": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cost"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reasoning": {
            "type": "boolean"
          },
          "reasoning_options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "values"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "effort"
                  ]
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "tool_call": {
            "type": "boolean"
          },
          "structured_output": {
            "type": "boolean"
          },
          "temperature": {
            "type": "boolean"
          },
          "modalities": {
            "type": "object",
            "properties": {
              "input": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "output": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "limit": {
            "type": "object",
            "properties": {
              "context": {
                "type": "integer"
              },
              "output": {
                "type": "integer"
              }
            }
          },
          "cost": {
            "type": "object",
            "description": "USD per million tokens.",
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cache_read": {
                "type": "number"
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Model lifecycle from the gateway catalog.",
            "enum": [
              "active",
              "deprecated",
              "retired"
            ]
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "billingTerms",
          "plan",
          "credits",
          "invoice",
          "models"
        ],
        "properties": {
          "billingTerms": {
            "type": "string",
            "enum": [
              "prepaid",
              "invoiced"
            ],
            "description": "How the organization is billed. `prepaid` spends a wallet and plan allowance; `invoiced` bills a monthly net-30 invoice against a spend limit."
          },
          "plan": {
            "type": "object",
            "required": [
              "label",
              "status",
              "dailyAllowance"
            ],
            "properties": {
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Plan name. Null when the organization has no plan."
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Plan status, such as `active`."
              },
              "dailyAllowance": {
                "description": "Share of today's allowance. Prepaid organizations only. Null for invoiced organizations, which bill against a spend limit rather than a daily grant, and for organizations with no allowance. `percent` can exceed 100 when usage is past the allowance. `basis` is `credit` when the day is sized in credits, `tokens` when it is sized in tokens, and `unavailable` when a credit-billed read failed.",
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CreditOrTokenAllowance"
                  },
                  {
                    "$ref": "#/components/schemas/UnavailableAllowance"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "credits": {
            "description": "Wallet balance and overage. Null for invoiced organizations, which have no wallet.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Credits"
              },
              {
                "type": "null"
              }
            ]
          },
          "invoice": {
            "description": "The active invoice window. Null for prepaid organizations.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/InvoiceUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "models": {
            "type": "array",
            "description": "Models with usage today. A model with no usage today is omitted, which means zero tokens so far.",
            "items": {
              "type": "object",
              "required": [
                "slug",
                "consumedToday"
              ],
              "properties": {
                "slug": {
                  "type": "string",
                  "example": "subconscious/glm-5.3-marathon"
                },
                "consumedToday": {
                  "type": "integer",
                  "description": "Tokens consumed by this model since UTC midnight."
                }
              }
            }
          }
        }
      },
      "Credits": {
        "type": "object",
        "required": [
          "balanceDollars",
          "overageThisPeriodDollars"
        ],
        "properties": {
          "balanceDollars": {
            "type": [
              "number",
              "null"
            ],
            "description": "Spendable credit balance in dollars. Null when the balance cannot be read."
          },
          "overageThisPeriodDollars": {
            "type": "number",
            "description": "Overage for the current period, in dollars. Currently always 0."
          }
        }
      },
      "InvoiceUsage": {
        "type": "object",
        "required": [
          "accruedThisPeriodDollars",
          "periodStart",
          "periodEnd",
          "limitDollars"
        ],
        "properties": {
          "accruedThisPeriodDollars": {
            "type": [
              "number",
              "null"
            ],
            "description": "Usage so far this period at the organization's rates, in dollars. Null when the read failed; never shown as zero."
          },
          "periodStart": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the current invoice period. Empty when the accrued read failed."
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time",
            "description": "End of the current invoice period. The spend limit resets here."
          },
          "limitDollars": {
            "type": [
              "number",
              "null"
            ],
            "description": "The spend limit in dollars. Null when the organization has none enabled."
          }
        }
      },
      "CreditOrTokenAllowance": {
        "type": "object",
        "required": [
          "basis",
          "percent",
          "resetAt"
        ],
        "properties": {
          "basis": {
            "type": "string",
            "enum": [
              "credit",
              "tokens"
            ]
          },
          "percent": {
            "type": "number",
            "description": "Percent of today's allowance already used. Can exceed 100."
          },
          "resetAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the daily counter resets (UTC midnight)."
          }
        }
      },
      "UnavailableAllowance": {
        "type": "object",
        "required": [
          "basis",
          "resetAt"
        ],
        "properties": {
          "basis": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          },
          "resetAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
